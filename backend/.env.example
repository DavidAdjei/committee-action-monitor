# Database
DATABASE_URL="mysql://user:pass@localhost:3306/committee_action_monitor"

# Local demo sign-in (never true in production)
DEV_AUTH_ENABLED=true

# --- Entra ID (API JWT validation for SPA Bearer tokens) ---
# Azure Portal → App registrations → your API app
ENTRA_TENANT_ID=
# Application ID URI or client id of the API app (audience of access tokens)
# Example: api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_API_AUDIENCE=

# Optional: create local User on first Entra login if not found by email/oid
ENTRA_AUTO_PROVISION=false

# --- Microsoft Graph directory sync (app-only) ---
# Prefer a separate app registration with User.Read.All (Application) + admin consent
ENTRA_GRAPH_TENANT_ID=
ENTRA_GRAPH_CLIENT_ID=
ENTRA_GRAPH_CLIENT_SECRET=
