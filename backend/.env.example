# Database
DATABASE_URL="mysql://user:pass@localhost:3306/committee_action_monitor"

# --- Entra ID (required — API JWT validation for SPA Bearer tokens) ---
# Azure Portal → App registrations → your API app
ENTRA_TENANT_ID=
# Application ID URI or client id of the API app (audience of access tokens)
# Example: api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_API_AUDIENCE=

# Optional: create local User on first Entra login if not found by email/oid
# Prefer directory sync for bank rollouts; keep false in production unless approved
ENTRA_AUTO_PROVISION=false

# Public SPA URL (links in emails)
APP_PUBLIC_URL=https://cam.example.com

# CORS (comma-separated origins if multiple)
CORS_ALLOWED_ORIGIN=https://cam.example.com

# --- Microsoft Graph (app-only) ---
# Directory sync: User.Read.All (Application) + admin consent
# Mail: Mail.Send (Application) + admin consent
# Teams app-only (optional fallback): OnlineMeetings.ReadWrite.All + Application Access Policy
ENTRA_GRAPH_TENANT_ID=
ENTRA_GRAPH_CLIENT_ID=
ENTRA_GRAPH_CLIENT_SECRET=
ENTRA_GRAPH_MAIL_SENDER=
# Optional: skip service-style accounts by email local-part prefix (comma-separated)
# GRAPH_SYNC_EXCLUDE_PREFIXES=svc-,sa-,noreply,app-
# Optional delegated scopes for interactive Teams creation (OBO / user token)
ENTRA_GRAPH_DELEGATED_SCOPES=https://graph.microsoft.com/OnlineMeetings.ReadWrite offline_access

# Email behaviour
# When true, log outbound mail instead of/in addition to Graph (local testing only)
MAIL_DEV_LOG=false
# Copy central committee distribution on action mails (enable when DLs are ready)
EMAIL_CC_CENTRAL_COMMITTEE=false

# Evidence downloads while virus scan is PENDING (default false in production)
EVIDENCE_ALLOW_PENDING_DOWNLOAD=false
