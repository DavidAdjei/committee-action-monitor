# API base (use /api with Vite proxy, or absolute Functions URL in production)
VITE_API_BASE_URL=/api

# --- Microsoft Entra ID (required for sign-in) ---
# SPA app registration
VITE_PUBLIC_AZURE_CLIENT_ID=
VITE_PUBLIC_AZURE_TENANT_ID=
# Access token scope for the API app, e.g. api://{api-client-id}/access_as_user
VITE_PUBLIC_SCOPE=

# Aliases (optional — used if VITE_PUBLIC_* are empty)
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_API_SCOPE=
