VITE_API_BASE_URL=http://localhost:7071/api

# Show demo user picker (set false for Microsoft-only)
VITE_DEV_AUTH=true

# --- Entra ID (preferred names — match other UMB apps) ---
VITE_PUBLIC_AZURE_CLIENT_ID=
VITE_PUBLIC_AZURE_TENANT_ID=
# API scope, e.g. api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/access_as_user
# (User.Read alone returns a Graph token; the API expects your API app audience)
VITE_PUBLIC_SCOPE=

# --- Legacy aliases (optional) ---
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_API_SCOPE=
